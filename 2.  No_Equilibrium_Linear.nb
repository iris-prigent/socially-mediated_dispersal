c0f6a8ab2bee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"values", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "\[Rule]", "4"}], ",", 
         RowBox[{"\[Beta]", "\[Rule]", "0.75"}], ",", 
         RowBox[{"Cc", "\[Rule]", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ",", 
         RowBox[{"cd", "\[Rule]", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ",", 
         RowBox[{"\[Delta]", "->", "1"}], ",", 
         RowBox[{"u", "\[Rule]", "1"}]}], "}"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Functions", " ", "=", " ", 
       RowBox[{"{", " ", 
        RowBox[{"Bc", "\[Rule]", 
         RowBox[{"Function", "[", 
          RowBox[{"k", ",", 
           RowBox[{"n", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"k", "/", "n"}], ")"}], "u"], " ", "\[Beta]"}]}], 
          "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ntest", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cdtest", " ", "=", " ", 
       RowBox[{"cd", "  ", "/.", " ", "values"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"utest", " ", "=", " ", 
       RowBox[{"u", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"valuesNeutral", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "\[Rule]", "ntest"}], ",", 
         RowBox[{"\[Beta]", "\[Rule]", "0"}], ",", 
         RowBox[{"Cc", "\[Rule]", " ", "0"}], ",", 
         RowBox[{"cd", "\[Rule]", "cdtest"}], ",", 
         RowBox[{"u", "\[Rule]", " ", "utest"}], ",", 
         RowBox[{"\[Delta]", "->", "0"}]}], " ", "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d0baseline", "=", 
       RowBox[{
        FractionBox["2", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "cd", " ", "n"}], "+", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["cd", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}]]}]], "/.", 
        "values"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Pk0", "[", 
        RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
       RowBox[{
        SuperscriptBox["z", "k"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}], 
         RowBox[{"n", "-", "k"}]], 
        RowBox[{"Binomial", "[", 
         RowBox[{"n", ",", "k"}], "]"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
        "cooperators", " ", "among", " ", "n", " ", "individuals", " ", 
        "when", " ", "the", " ", "population", " ", "is", " ", "monomorphic", 
        " ", "for", " ", "z"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fec", "[", 
        RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Delta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", 
            RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ",
         "cooperating", " ", 
        RowBox[{"(", 
         RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 
        RowBox[{"(", 
         RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ",
         "with", " ", "k", " ", "cooperators"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{"\[Delta]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "/", "n"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", "Cc"}], " ", 
              ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"k", "/", "n"}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], ")"}]}]}], 
           ")"}]}]}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "average", " ", "fecundity", " ", "in", " ", "a", " ", "patch", " ", 
        "with", " ", "k", " ", "cooperators"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
       RowBox[{
        RowBox[{"fecpatch", "[", "k", "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
       "offspring", " ", "produced", " ", "that", " ", "will", " ", "remain", 
        " ", "in", " ", "their", " ", "local", " ", "patch"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k2", "=", "0"}], "n"], 
        RowBox[{
         RowBox[{"d", "[", "k2", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "cd"}], ")"}], " ", 
         RowBox[{"fecpatch", "[", "k2", "]"}], 
         RowBox[{"Pk0", "[", 
          RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fecloc", "=", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"d", "[", 
             RowBox[{"1", ",", 
              RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
           ")"}], " ", 
          RowBox[{
           RowBox[{"fec", "[", 
            RowBox[{
             RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
            "]"}], "/", "n"}]}], "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"d", "[", 
             RowBox[{"2", ",", 
              RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
           ")"}], " ", 
          RowBox[{
           RowBox[{"fec", "[", 
            RowBox[{
             RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c2"}], 
            "]"}], "/", "n"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"d", "[", 
             RowBox[{"3", ",", 
              RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
           ")"}], 
          RowBox[{
           RowBox[{"fec", "[", 
            RowBox[{
             RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c3"}], 
            "]"}], "/", "n"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"d", "[", 
             RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], ")"}], 
          " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "3", "-", "c0"}], ")"}], 
             RowBox[{
              RowBox[{"fec", "[", 
               RowBox[{
                RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "0"}], 
               "]"}], "/", "n"}]}], "+", 
            RowBox[{"c0", " ", 
             RowBox[{
              RowBox[{"fec", "[", 
               RowBox[{
                RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "1"}], 
               "]"}], "/", "n"}]}]}], ")"}]}]}], " ", ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "number", " ", "of", " ", "offspring", " ", "coming", " ", "into", " ",
         "an", " ", "arbirary", " ", "patch", " ", "when", " ", "the", " ", 
        "population", " ", "is", " ", "monomorphic", " ", "for", " ", "z"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m", "[", "k0_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"fecdisp", "[", 
          RowBox[{"d", "[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fecphilo", "[", "k0", "]"}], "+", 
           RowBox[{"fecdisp", "[", 
            RowBox[{"d", "[", 
             RowBox[{"n", "+", "1"}], "]"}], "]"}]}], " ", ")"}]}], "/.", 
        "valuesNeutral"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"monopop", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"i", ",", "k"}], "]"}], "\[Rule]", " ", 
            RowBox[{"d", "[", "k", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{"ntest", "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solR2", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"R2", " ", "\[Equal]", " ", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"k0", " ", "=", "0"}], "n"], 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"m", "[", "k0", "]"}]}], ")"}], "2"], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "n"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], "/", "n"}], ")"}], 
                  "R2"}]}], ")"}], 
               RowBox[{"Pk0", "[", 
                RowBox[{"k0", ",", 
                 RowBox[{"d", "[", 
                  RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], "/.",
             "valuesNeutral"}], ")"}], ",", "R2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"c0", "=", "0"}], 
           RowBox[{"n", "-", "3"}]], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"c3", "=", "0"}], "1"], 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"c2", "=", "0"}], "1"], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"c1", "=", "0"}], "1"], 
             RowBox[{
              RowBox[{"fec", "[", 
               RowBox[{
                RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
               "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", "  ", 
                  RowBox[{"1", "-", 
                   RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"fecloc", "+", " ", 
                   RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], " ", "+",
                 " ", 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"k0", "=", "0"}], "n"], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}], 
                    
                    RowBox[{"(", 
                    RowBox[{"1", "-", "cd"}], ")"}]}], " ", ")"}], "/", 
                    RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{"fecphilo", "[", "k0", "]"}], "+", " ", 
                    RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], ")"}], 
                  RowBox[{"Pk0", "[", 
                   RowBox[{"k0", ",", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], 
               ")"}], 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c1"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"1", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c1"}]], " ", 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c2"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"2", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c2"}]], 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"3", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c3"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"3", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c3"}]], " ", 
              RowBox[{"Pk0", "[", 
               RowBox[{"c0", ",", 
                RowBox[{"d", "[", 
                 RowBox[{"n", "+", "1"}], "]"}], ",", 
                RowBox[{"n", "-", "3"}]}], "]"}]}]}]}]}]}], "//.", 
         "Functions"}], "//.", "values"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Fitness", " ", "of", " ", "a", " ", "focal", " ", "individual"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"S", "=", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"w", ",", " ", 
               RowBox[{"d", "[", 
                RowBox[{"1", ",", "k"}], "]"}]}], "]"}], "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}], "R2", " ", 
              RowBox[{"D", "[", 
               RowBox[{"w", ",", " ", 
                RowBox[{"d", "[", 
                 RowBox[{"2", ",", "k"}], "]"}]}], "]"}]}]}], "/.", " ", 
            "solR2"}], " ", "/.", " ", "monopop"}], " ", "/.", "values"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"ntest", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"test", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Catch", "[", "\[IndentingNewLine]", 
       RowBox[{"While", "[", " ", 
        RowBox[{
         RowBox[{"0", "<", "test", "<", "10"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"test", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Quiet", "[", 
           RowBox[{"equiN", "=", 
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"S", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "0"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", 
                  RowBox[{"ntest", "+", "2"}]}], "}"}]}], "]"}], ",", " ", 
              RowBox[{"Append", "[", " ", 
               RowBox[{
                RowBox[{"Table", "[", " ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"d", "[", "k", "]"}], ",", 
                    RowBox[{"RandomReal", "[", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "0", ",", 
                    "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "0", ",", "ntest"}], "}"}]}], "]"}], " ",
                 ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"ntest", "+", "1"}], "]"}], ",", 
                  RowBox[{"RandomReal", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "0", ",", 
                  "1"}], "}"}]}], "]"}]}], "]"}]}], " ", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"max", " ", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "/@", " ", 
             RowBox[{"(", 
              RowBox[{"S", " ", "/.", " ", "equiN"}], ")"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Chop", "[", "max", "]"}], " ", "\[Equal]", " ", "0"}], ",", 
            RowBox[{"Throw", "[", 
             RowBox[{"{", 
              RowBox[{"values", ",", "equiN"}], "}"}], "]"}]}], " ", 
           "]"}]}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "==", "5000"}], ",", 
        RowBox[{
        "Print", "[", "\"\<No equilibrium strategy was found\>\"", "]"}]}], 
       "]"}]}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "5000"}], "}"}]}], "\[IndentingNewLine]", 

Cell[CellGroupData[{

Cell["\<\
Stability analyses to search for equilibrium value of cooperation when \
cooperation gives linear returns\
\>", "Title",
 CellChangeTimes->{{3.9805015954313297`*^9, 3.9805015954313297`*^9}, {
  3.9805016280780563`*^9, 
  3.9805016712369766`*^9}},ExpressionUUID->"8424eb25-af0c-9e41-be6b-\
7903e0793bc2"],

Cell[TextData[{
 "Here we perform numerical stability analyses, looking for a value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"(", 
     RowBox[{"z", ",", 
      SubscriptBox["d", "0"], ",", "...", ",", 
      SubscriptBox["d", "N"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53898ff9-a236-9c40-82b9-498fd342209d"],
 ") where directional selection is null on all traits. To do so, we use the \
Mathematica function \[OpenCurlyDoubleQuote]FindRoot\[CloseCurlyDoubleQuote]. \
This corresponds to the procedure described in section 3.2 of the main text \
and section D.3.1 of the Appendix"
}], "Text",
 CellChangeTimes->{{3.968833285311166*^9, 3.968833296963772*^9}, {
  3.980501689034588*^9, 3.9805018076367474`*^9}, {3.9805018744431095`*^9, 
  3.980501889340559*^9}, {3.9805019999171333`*^9, 
  3.9805020282591286`*^9}},ExpressionUUID->"6e027ee9-084c-4c02-a312-\
1291f1cc0e4c"],

Cell[CellGroupData[{

Cell["b = 0.75", "Subsection",
 CellChangeTimes->{{3.761458333892454*^9, 3.7614583437699337`*^9}, {

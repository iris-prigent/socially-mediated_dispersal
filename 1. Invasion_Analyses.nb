    "\[IndentingNewLine]", 
    RowBox[{"lightred", "=", 
     RowBox[{"RGBColor", "[", "\"\<#f27c7c\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cm", "=", 
     RowBox[{"72", "/", "2.54"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"monopop", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"d", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "\[Rule]", " ", 
          RowBox[{"d", "[", "k", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{

Cell["\<\
We can then visualize the balance between the two effects by using the \
following function:\
\>", "Text",
 CellChangeTimes->{{3.98050119360363*^9, 
  3.9805012324529133`*^9}},ExpressionUUID->"e7f09d3f-1e58-4f47-b8ae-\
16a1f0682fea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeplotRegion", "[", 
   RowBox[{"n_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"grey", "=", 
     RowBox[{"RGBColor", "[", "\"\<#878E88\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yellow", "=", " ", 
     RowBox[{"RGBColor", "[", "\"\<#F7CB15\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"violet", "=", 
     RowBox[{"RGBColor", "[", "\"\<#B989A9\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"darkviolet", "=", 
     RowBox[{"RGBColor", "[", "\"\<#885075\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"red", "=", 
     RowBox[{"RGBColor", "[", "\"\<#C71F1F\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"lightred", "=", 
     RowBox[{"RGBColor", "[", "\"\<#f27c7c\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cm", "=", 
     RowBox[{"72", "/", "2.54"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"monopop", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"d", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "\[Rule]", " ", 
          RowBox[{"d", "[", "k", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"uncond1", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"d", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "\[Rule]", " ", 
          RowBox[{"d", "[", 
           RowBox[{"i", ",", "0"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"uncond2", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"d", "[", "k", "]"}], "\[Rule]", " ", 
          RowBox[{"d", "[", "0", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], " ", "]"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Pk0", "[", 
      RowBox[{"k_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      SuperscriptBox["z", "k"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}], 
       RowBox[{"n", "-", "k"}]], 
      RowBox[{"Binomial", "[", 
       RowBox[{"n", ",", "k"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fec", "[", 
      RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"Bc", "[", "k", "]"}], "n"], "-", 
          RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " ", ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", " ", 
       RowBox[{"\[Delta]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", " ", "/", "n"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"Bc", "[", "k", "]"}], "n"], "-", "Cc"}], " ", ")"}]}], 
          "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"k", "/", "n"}]}], ")"}], 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"Bc", "[", "k", "]"}], "n"], ")"}]}]}], ")"}]}]}], 
      ")"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"fecpatch", "[", "k", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k2", "=", "0"}], "n"], 
      RowBox[{
       RowBox[{"d", "[", "k2", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "cd"}], ")"}], " ", 
       RowBox[{"fecpatch", "[", "k2", "]"}], 
       RowBox[{"Pk0", "[", 
        RowBox[{"k2", ",", "z"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "[", "k_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"fecdisp", "[", "z", "]"}], " "}], 
       RowBox[{
        RowBox[{
         RowBox[{"fecpatch", "[", "k", "]"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", 
        RowBox[{"fecdisp", "[", "z", "]"}], " "}]], "/.", 
      RowBox[{"\[Delta]", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"solR2", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"R2", " ", "\[Equal]", " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k", " ", "=", "0"}], "n"], 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"m", "[", "k", "]"}]}], ")"}], "2"], 
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "n"], "+", 
              RowBox[{
               FractionBox[
                RowBox[{"n", "-", "1"}], "n"], "R2"}]}], ")"}], 
            RowBox[{"Pk0", "[", 
             RowBox[{"k", ",", "z"}], "]"}]}]}]}], "/.", 
         RowBox[{"\[Delta]", "->", "0"}]}], ",", "R2"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"solR2R", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"R2R", " ", "\[Equal]", " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k", " ", "=", "0"}], "n"], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "n"], "+", 
              RowBox[{
               FractionBox[
                RowBox[{"n", "-", "1"}], "n"], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"m", "[", "k", "]"}]}], ")"}], "2"], "R2R"}]}], 
             ")"}], 
            RowBox[{"Pk0", "[", 
             RowBox[{"k", ",", "z"}], "]"}]}]}]}], "/.", 
         RowBox[{"\[Delta]", "->", "0"}]}], ",", "R2R"}], "]"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"d0baseline", "=", 
     FractionBox["2", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "cd", " ", "n"}], "+", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["cd", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}]]}]]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wNeutral", "[", 
      RowBox[{"k_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"(", "  ", 
          RowBox[{"1", "-", 
           RowBox[{"d", "[", "k", "]"}]}], ")"}], 
         RowBox[{" ", 
          RowBox[{
           RowBox[{
            RowBox[{"fecpatch", "[", "k", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", " ", 
           RowBox[{"fecdisp", "[", "z", "]"}]}]}]], " ", "+", " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"kd", "=", "0"}], "n"], 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"d", "[", "k", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", "cd"}], ")"}], " "}], 
           RowBox[{" ", 
            RowBox[{
             RowBox[{"fecphilo", "[", "kd", "]"}], "+", " ", 
             RowBox[{"fecdisp", "[", "z", "]"}]}]}]], 
          RowBox[{"Pk0", "[", 
           RowBox[{"kd", ",", "z"}], "]"}]}]}]}], ")"}], "/.", 
      RowBox[{"\[Delta]", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"A", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"n", " ", "R2R", 
            FractionBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"wNeutral", "[", 
                RowBox[{
                 RowBox[{"n", "-", "1"}], ",", "z"}], "]"}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"wNeutral", "[", 
                 RowBox[{
                  RowBox[{"n", "-", "1"}], ",", "z"}], "]"}], ")"}], "-", 
               RowBox[{"R2R", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"m", "[", 
                    RowBox[{"n", "-", "1"}], "]"}]}], ")"}], "2"]}]}], 
              ")"}]]}], "/.", "solR2R"}], "/.", "solR2"}], "/.", 
         RowBox[{"z", "->", "1"}]}], "/.", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"n", "+", "1"}], "]"}], "->", "1"}]}], "/.", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"n", "-", "1"}], "]"}], "->", 
        SubscriptBox["d", 
         RowBox[{"n", "-", "1"}]]}]}], "/.", 
      RowBox[{
       RowBox[{"d", "[", "n", "]"}], "->", "d0baseline"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Kappa]", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{" ", 
             RowBox[{
              RowBox[{"R2", " ", 
               RowBox[{"(", 
                RowBox[{"wNeutral", "[", 
                 RowBox[{
                  RowBox[{"n", "-", "1"}], ",", "z"}], "]"}], ")"}]}], "-", 
              " ", 
              RowBox[{"R2R", " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"m", "[", 
                   RowBox[{"n", "-", "1"}], "]"}]}], ")"}], "2"]}]}]}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"wNeutral", "[", 
                RowBox[{
                 RowBox[{"n", "-", "1"}], ",", "z"}], "]"}], ")"}], "-", 
              RowBox[{"R2R", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"m", "[", 
                   RowBox[{"n", "-", "1"}], "]"}]}], ")"}], "2"]}]}], ")"}]], 
           "/.", "solR2R"}], "/.", "solR2"}], "/.", 
         RowBox[{"z", "->", "1"}]}], "/.", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"n", "+", "1"}], "]"}], "->", "1"}]}], "/.", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"n", "-", "1"}], "]"}], "->", 
        SubscriptBox["d", 
         RowBox[{"n", "-", "1"}]]}]}], "/.", 
      RowBox[{
       RowBox[{"d", "[", "n", "]"}], "->", "d0baseline"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"pdisp", "=", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         SubscriptBox["d", 
          RowBox[{"n", "-", "1"}]], "\[Equal]", " ", "d0baseline"}], "]"}], 
       " ", ",", 
       RowBox[{"{", 
        RowBox[{"cd", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["d", 
          RowBox[{"n", "-", "1"}]], ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"ContourStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"p0", "=", 
     RowBox[{"RegionPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"A", "+", 
           RowBox[{
            FractionBox[
             RowBox[{"n", "-", "1"}], "n"], "\[CapitalDelta]B", " ", 
            "\[Kappa]"}], "-", "c", "+", " ", 
           FractionBox["\[CapitalDelta]B", "n"]}], "<", "0"}], "/.", 
         RowBox[{"c", "->", "0.25"}]}], "/.", 
        RowBox[{"\[CapitalDelta]B", "->", "B"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"cd", ",", "0", ",", "1.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["d", 
          RowBox[{"n", "-", "1"}]], ",", 
         RowBox[{"-", "0.1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Directive", "[", "lightred", "]"}]}], ",", 
       RowBox[{"BoundaryStyle", "\[Rule]", "Black"}], ",", 
       RowBox[{"MaxRecursion", "\[Rule]", "10"}]}], "]"}]}], " ", ";", 
    "\[IndentingNewLine]", 
    RowBox[{"plotfinal", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"p0", ",", "pdisp", ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<dispersal cost, \!\(\*StyleBox[SubscriptBox[\"c\", \
StyleBox[\"d\",FontSlant->\"Plain\"]],FontSlant->\"Italic\"]\)\>\"", ",", 
          "None"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotRangePadding", "->", "None"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
          RowBox[{"FontSize", "\[Rule]", "14"}], ",", "Black", ",", 
          RowBox[{"ImageSize", "->", 
           RowBox[{"10", " ", "cm"}]}]}], "]"}]}], ",", 
       RowBox[{"FrameTicks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", ".5", ",", "1"}], "}"}], ",", "None"}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", ".5", ",", "1"}], "}"}], ",", "None"}], 
           "}"}]}], "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",

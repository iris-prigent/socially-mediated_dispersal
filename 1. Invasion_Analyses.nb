       RowBox[{"\[Delta]", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"Bc", "[", "k", "]"}], "n"], "-", 
          RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " ", ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", " ", 
       RowBox[{"\[Delta]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", " ", "/", "n"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"Bc", "[", "k", "]"}], "n"], "-", "Cc"}], " ", ")"}]}], 
          "+", 
          RowBox[{
           RowBox[{"(", 

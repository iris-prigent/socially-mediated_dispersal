Cell[BoxData[{
 RowBox[{
  RowBox[{"Pk0", "[", 
   RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"PDF", "[", 
   RowBox[{
    RowBox[{"BinomialDistribution", "[", 
     RowBox[{"n", ",", "z"}], "]"}], ",", "k"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fec", "[", 
    RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"\[Delta]", " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"Bc", "[", "k", "]"}], "n"], "-", 
        RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"1", "+", " ", 
     RowBox[{"\[Delta]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", " ", "/", "n"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"Bc", "[", "k", "]"}], "n"], "-", "Cc"}], " ", ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"k", "/", "n"}]}], ")"}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"Bc", "[", "k", "]"}], "n"], ")"}]}]}], ")"}]}]}], ")"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"fecpatch", "[", "k", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k2", "=", "0"}], "n"], 
    RowBox[{
     RowBox[{"d", "[", "k2", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "cd"}], ")"}], " ", 
     RowBox[{"fecpatch", "[", "k2", "]"}], 
     RowBox[{"Pk0", "[", 
      RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"c0", "=", "0"}], 
     RowBox[{"n", "-", "3"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"c3", "=", "0"}], "1"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"c2", "=", "0"}], "1"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"c1", "=", "0"}], "1"], 
       RowBox[{
        RowBox[{"fec", "[", 
         RowBox[{
          RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", "  ", 
            RowBox[{"1", "-", 
             RowBox[{"d", "[", 
              RowBox[{"1", ",", 
               RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
            ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"d", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                   "]"}]}], ")"}], " ", 
                RowBox[{
                 RowBox[{"fec", "[", 
                  RowBox[{
                   RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                   "c1"}], "]"}], "/", "n"}]}], "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"d", "[", 
                   RowBox[{"2", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                   "]"}]}], ")"}], " ", 
                RowBox[{
                 RowBox[{"fec", "[", 
                  RowBox[{
                   RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                   "c2"}], "]"}], "/", "n"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"d", "[", 
                   RowBox[{"3", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                   "]"}]}], ")"}], 
                RowBox[{
                 RowBox[{"fec", "[", 
                  RowBox[{
                   RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                   "c3"}], "]"}], "/", "n"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"d", "[", 
                   RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], 
                 ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"n", "-", "3", "-", "c0"}], ")"}], 
                   RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "0"}], "]"}], "/", "n"}]}], "+", 
                  RowBox[{"c0", " ", 
                   RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "1"}], "]"}], "/", "n"}]}]}], ")"}]}]}], " ", ")"}], "+", 
             " ", 
             RowBox[{"fecdisp", "[", 
              RowBox[{"d", "[", 
               RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], " ", "+", 
          " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k0", "=", "0"}], "n"], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"1", ",", 
                  RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}], 
                RowBox[{"(", 
                 RowBox[{"1", "-", "cd"}], ")"}]}], " ", ")"}], "/", 
              RowBox[{"(", " ", 
               RowBox[{
                RowBox[{"fecphilo", "[", "k0", "]"}], "+", " ", 
                RowBox[{"fecdisp", "[", 
                 RowBox[{"d", "[", 
                  RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], ")"}], 
            RowBox[{"Pk0", "[", 
             RowBox[{"k0", ",", 
              RowBox[{"d", "[", 
               RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], ")"}], 
        SuperscriptBox[
         RowBox[{"d", "[", 
          RowBox[{"1", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}], "c1"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"d", "[", 
            RowBox[{"1", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
         RowBox[{"1", "-", "c1"}]], " ", 
        SuperscriptBox[
         RowBox[{"d", "[", 
          RowBox[{"2", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}], "c2"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"d", "[", 
            RowBox[{"2", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
         RowBox[{"1", "-", "c2"}]], 
        SuperscriptBox[
         RowBox[{"d", "[", 
          RowBox[{"3", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}], "c3"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"d", "[", 
            RowBox[{"3", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
         RowBox[{"1", "-", "c3"}]], " ", 
        RowBox[{"Pk0", "[", 
         RowBox[{"c0", ",", 
          RowBox[{"d", "[", 
           RowBox[{"n", "+", "1"}], "]"}], ",", 
          RowBox[{"n", "-", "3"}]}], "]"}]}]}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wmono", "[", 
    RowBox[{"k_", ",", "z_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"fec", "[", 
     RowBox[{"k", ",", "j"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"(", "  ", 
        RowBox[{"1", "-", 
         RowBox[{"d", "[", "k", "]"}]}], ")"}], 
       RowBox[{" ", 
        RowBox[{
         RowBox[{
          RowBox[{"fecpatch", "[", "k", "]"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", " ", 
         RowBox[{"fecdisp", "[", "z", "]"}]}]}]], " ", "+", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"kd", "=", "0"}], "n"], 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"d", "[", "k", "]"}], 

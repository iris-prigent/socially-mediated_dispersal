Cell["\<\
In this section draw fig 8c of the main text and Fig S2d-e of the appendix. \
You will find in the repository the .txt files that we use to draw these \
figures, which are obtained from iterating the previous procedure from \
different sets of parameters.\
\>", "Text",
 CellChangeTimes->{{3.980507812126398*^9, 3.980507836555645*^9}, {
  3.988893583730114*^9, 3.9888936336859226`*^9}, {3.9888937971407166`*^9, 
  3.988893890769331*^9}, {3.9888939885244827`*^9, 
  3.9888941284902935`*^9}},ExpressionUUID->"80b187b0-e897-1f49-be03-\
a1b66d1c2f96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rImport", "[", 
    RowBox[{"\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_"}],
     "]"}], ":=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"\"\<Saturating_B_\>\"", "<>", 
      RowBox[{"TextString", "[", "\[Beta]val", "]"}], "<>", "\"\<_C_\>\"", "<>", 
      RowBox[{"TextString", "[", "Ccval", "]"}], "<>", "\"\<_delta_\>\"", "<>", 
      RowBox[{"TextString", "[", "\[Delta]val", "]"}], "<>", "\"\<_n_\>\"", "<>", 
      RowBox[{"TextString", "[", "nval", "]"}], "<>", "\"\<.txt\>\""}], 
     ",", "\"\<Table\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ztrait", "[", 
    RowBox[{
    "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
     "cdvect_", ",", "uval_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"results", "=", 
      RowBox[{"rImport", "[", 
       RowBox[{"\[Beta]val", ",", "Ccval", ",", "\[Delta]val", ",", "nval"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"results", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Listres", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"results", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "==", "uval"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"traits", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"Listres", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "cdi"}], "&"}]}], 
           "]"}]}], ";", "a"}], ",", 
        RowBox[{"{", 
         RowBox[{"cdi", ",", "cdvect"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"traits", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"traits", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", 
          RowBox[{"-", "4"}]}], "}"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtrait", "[", 
    RowBox[{
    "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
     "cdvect_", ",", "uval_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"results", "=", 
      RowBox[{"rImport", "[", 
       RowBox[{"\[Beta]val", ",", "Ccval", ",", "\[Delta]val", ",", "nval"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"results", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Listres", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"results", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "==", "uval"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"traits", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"Listres", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 

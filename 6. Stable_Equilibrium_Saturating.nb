Cell[CellGroupData[{

Cell["3.1 Evolution of dispersal", "Subsection",
 CellChangeTimes->{{3.9805078514675198`*^9, 3.9805078693557987`*^9}, {
  3.9805079682479496`*^9, 
  3.9805079692836056`*^9}},ExpressionUUID->"fc83387a-8c52-ac4e-996d-\
f0b728379c74"],

Cell["\<\
In this section we read the  . txt file obtained from the numerical analyses \
and draw fig 8d of the main text and Fig S3 and S4 of the appendix .\
\>", "Text",
 CellChangeTimes->{{3.980507812126398*^9, 3.980507836555645*^9}, {
  3.9805079743788986`*^9, 
  3.980507987092552*^9}},ExpressionUUID->"43300b94-763b-894d-9778-\
df1f77fcff89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rImport", "[", 
    RowBox[{"\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_"}],
     "]"}], ":=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"\"\<Saturating_B_\>\"", "<>", 
      RowBox[{"TextString", "[", "\[Beta]val", "]"}], "<>", "\"\<_C_\>\"", "<>", 
      RowBox[{"TextString", "[", "Ccval", "]"}], "<>", "\"\<_d_\>\"", "<>", 
      RowBox[{"TextString", "[", "\[Delta]val", "]"}], "<>", "\"\<_n_\>\"", "<>", 
      RowBox[{"TextString", "[", "nval", "]"}], "<>", "\"\<.txt\>\""}], 
     ",", "\"\<Table\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtrait", "[", 
    RowBox[{
    "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
     "cdvect_", ",", "uval_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"results", "=", 
      RowBox[{"rImport", "[", 
       RowBox[{"\[Beta]val", ",", "Ccval", ",", "\[Delta]val", ",", "nval"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"results", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Listres", "=", 
      RowBox[{"Select", "[", 

      RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ", 
     "with", " ", "k", " ", "cooperators"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{

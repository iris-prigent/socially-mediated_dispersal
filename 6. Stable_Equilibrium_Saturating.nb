Cell[CellGroupData[{

Cell["3.1 Evolution of dispersal", "Subsection",
 CellChangeTimes->{{3.9805078514675198`*^9, 3.9805078693557987`*^9}, {
  3.9805079682479496`*^9, 
  3.9805079692836056`*^9}},ExpressionUUID->"fc83387a-8c52-ac4e-996d-\
f0b728379c74"],

Cell["\<\
In this section we draw fig 8d of the main text and  Fig S3 and S4 of the \
appendix. To do so, we compute the singular probabilities of dispersal and \
plot them using the function defined below.\
\>", "Text",
 CellChangeTimes->{{3.980507812126398*^9, 3.980507836555645*^9}, {
  3.9805079743788986`*^9, 3.980507987092552*^9}, {3.9890522690050697`*^9, 
  3.9890523420123024`*^9}},ExpressionUUID->"43300b94-763b-894d-9778-\
df1f77fcff89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PlotDisp", "[", 
   RowBox[{
   "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
    "cdvect_", ",", "uval_", ",", "shape_", ",", "size_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"CalcSingVal", "[", 
      RowBox[{
      "\[Beta]val", ",", "Ccval", ",", "\[Delta]val", ",", "nval", ",", 
       "cdvect", ",", "uval", ",", "\"\<\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"coop", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"nval", ",", "nval"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"x2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"coop", ",", 
          RowBox[{
           RowBox[{"Transpose", "[", "x1", "]"}], "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "cdvect", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"plotdCondi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"x2", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"{", 

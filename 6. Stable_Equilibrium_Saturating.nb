   RowBox[{
    RowBox[{
     RowBox[{"fec", "[", 
      RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", 
          RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ", 
     "cooperating", " ", 
     RowBox[{"(", 
      RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 

       RowBox[{"n", "-", "k"}]], 
      RowBox[{"Binomial", "[", 
       RowBox[{"n", ",", "k"}], "]"}]}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
    "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
     "cooperators", " ", "among", " ", "n", " ", "individuals", " ", "when", " ",
      "the", " ", "population", " ", "is", " ", "monomorphic", " ", "for", " ",

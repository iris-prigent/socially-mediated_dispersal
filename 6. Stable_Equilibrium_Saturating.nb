Cell[BoxData[
 RowBox[{
  RowBox[{"PlotDispf", "[", 
   RowBox[{
   "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
    "cdvect_", ",", "uval_", ",", "shape_", ",", "size_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"listc", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Lighter", "[", 
         RowBox[{"blue", ",", "#"}], "]"}], "&"}], ",", 
       RowBox[{"Reverse", "[", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "0.8", ",", 
          RowBox[{"N", "[", 
           RowBox[{"0.8", "/", 
            RowBox[{"(", "6", ")"}]}], "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"mycolor", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", 
       RowBox[{"listc", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "*", "nval"}], ")"}], "+", "1"}], "]"}], "]"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"x1", "=", 
     RowBox[{"CalcSingVal", "[", 
      RowBox[{
      "\[Beta]val", ",", "Ccval", ",", "\[Delta]val", ",", "nval", ",", 
       "cdvect", ",", "uval", ",", "\"\<\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"coop", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"1", ",", "nval"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"x2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"coop", ",", 
          RowBox[{
           RowBox[{"Transpose", "[", "x1", "]"}], "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "cdvect", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"plotdCondi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"x2", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"Dashed", ",", "Black", ",", 
           RowBox[{"Thickness", "[", "0.002", "]"}]}], "}"}], "}"}]}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"plotdCondi2", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"x2", ",", 
       RowBox[{"ColorFunction", "->", "mycolor"}], ",", 
       RowBox[{"PlotMarkers", "\[Rule]", 
        RowBox[{"Style", "[", 
         RowBox[{"shape", ",", "size"}], "]"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"x", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"plotdCondi", ",", "plotdCondi2"}], "}"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
          RowBox[{"FontSize", "\[Rule]", "12"}], ",", "Black"}], "]"}]}], ",", 
       RowBox[{"FrameTicks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0.25", ",", ".5", ",", "0.75"}], "}"}], ",", 
            "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0.5", ",", "1"}], "}"}], ",", "None"}], 
           "}"}]}], "}"}]}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0.75"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", "0.75"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<k\>\"", 
          ",", "\"\<\!\(\*SuperscriptBox[\(d\), \(*\)]\)\>\""}], "}"}]}], ",", 
       RowBox[{"RotateLabel", "->", "False"}]}], "]"}]}]}], ")"}]}]], "Input",\


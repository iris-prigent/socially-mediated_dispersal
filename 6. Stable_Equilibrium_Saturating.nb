Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "The", " ", "function", " ", "below", " ", "performs", " ", "numerical", 
      " ", "stability", " ", "analyses"}], ",", 
     RowBox[{"looking", " ", "for", " ", "a", " ", "value", " ", "of", " ", 
      FormBox[
       RowBox[{"x", "=", 
        RowBox[{"(", 
         RowBox[{"z", ",", 
          SubscriptBox["d", "0"], ",", "...", ",", 
          SubscriptBox["d", "N"]}]}]}],
       TraditionalForm]}]}], ")"}], " ", "where", " ", "directional", " ", 
   "selection", " ", "is", " ", "null", " ", "on", " ", "all", " ", 
   RowBox[{"traits", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "the", " ", "singular", " ", "value", " ", "under", " ", "unconditional", " ",
    "dispersal", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"when", " ", 
       SubscriptBox["d", "0"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["d", "1"], "=."}], ".."}], "=", 
       SubscriptBox["d", "N"]}]}], ")"}], ".", " ", "To"}], " ", "do", " ", 
   "so"}], ",", " ", 
  RowBox[{"we", " ", "use", " ", "the", " ", "Mathematica", " ", "function", " ", 
   RowBox[{"\"\<FindRoot\>\"", ".", " ", "If"}], " ", "the", " ", "function", 
   " ", "could", " ", "not", " ", "find", " ", "any", " ", "singular", " ", 
   "strategy", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"e", ".", "g", ".", " ", "because"}], " ", "the", " ", 
     "solution", " ", "does", " ", "not", " ", "exist", " ", "within", " ", 
     "the", " ", "trait", " ", "boundaries"}], ")"}]}], ",", " ", 
  RowBox[{
  "we", " ", "iterate", " ", "the", " ", "selection", " ", "gradient", " ", 
   "trait", " ", "value", " ", "arrives", " ", "at", " ", "an", " ", 
   RowBox[{"equilibrium", ".", " ", "This"}], " ", "corresponds", " ", "to", " ",
    "the", " ", "procedure", " ", "described", " ", "in", " ", "section", " ",
    "3.3", " ", "of", " ", "the", " ", "main", " ", "text", " ", "and", " ", 
   "section", " ", "D", ".3", ".1", " ", "of", " ", "the", " ", 
   RowBox[{"Appendix", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "whether", " ", "the", " ", "singular", " ", "strategy", " ", "found", " ",
    "is", " ", "convergence", " ", "stable", " ", "by", " ", "computing", " ",
    "the", " ", "eigenvalues", " ", "if", " ", "the", " ", "Jacobian", " ", 
   "Matrix", " ", "at", " ", "the", " ", "singular", " ", "strategy", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
      "procedure", " ", "described", " ", "in", " ", "Appendix", " ", "D", 
       ".3", 
       RowBox[{".2", ".", " ", "The"}], " ", "function", " ", "returns", " ", 
       "the", " ", "singular", " ", "probability", " ", "of", " ", 
       "cooperation", " ", "when", " ", "output"}], "=", 
      RowBox[{"\"\<pz\>\"", " ", "and", " ", "the", " ", "singular", " ", 
       "probabilities", " ", "of", " ", "dispersal", " ", 
       RowBox[{"otherwise", ".", " ", "We"}], " ", "then", " ", "plot", " ", 
       "these", " ", "output", " ", "using", " ", "another", " ", 
       RowBox[{"function", ".", " ", "The"}], " ", "function", " ", "will", " ",
        "also", " ", "print", " ", "\"\<convergence unstable\>\"", " ", "if", 
       " ", "the", " ", "largest", "  ", "eigenvalues", " ", "of", " ", "the",
        " ", "Jacobian", " ", "is", " ", 
       RowBox[{"positive", ".", " ", "If"}], " ", "all", " ", "are", " ", 
       "stable", " ", 
       RowBox[{"(", 
        RowBox[{
        "as", " ", "this", " ", "is", " ", "the", " ", "case", " ", "here"}], 
        ")"}]}]}], ",", " ", 
     RowBox[{"it", " ", "will", " ", "print", " ", 
      RowBox[{"\"\<All singular strategies are convergence stable\>\"", ".", 
       "\[IndentingNewLine]", "Finally"}], " ", "we", " ", "compute", " ", 
      "the", " ", "Hessian", " ", "matrix", " ", "to", " ", "determine", " ", 
      "the", " ", "evolutionary", " ", "stability", " ", "of", " ", "the", " ", 
      RowBox[{"population", ".", " ", "The"}], " ", "function", " ", 
      "returns", " ", "the", " ", "largest", " ", "eigenvalues", " ", "of", 
      " ", "the", " ", "Hessian"}], ",", 
     RowBox[{
     "if", " ", "positive", " ", "this", " ", "denotes", " ", "that", " ", 
      "the", " ", "population", " ", "will", " ", "become", " ", 
      RowBox[{"polymorphic", "."}]}]}]}]}]}]], "Text",
 CellChangeTimes->{{3.9805042705898876`*^9, 3.9805042903561745`*^9}, {
   3.980504338492836*^9, 3.980504409075577*^9}, {3.9805044901538887`*^9, 

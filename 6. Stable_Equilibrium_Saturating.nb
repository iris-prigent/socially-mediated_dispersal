Cell["2. Numerical analyses", "Section",
 CellChangeTimes->{{3.761458333892454*^9, 3.7614583437699337`*^9}, {
  3.9683081205610776`*^9, 3.9683081314968247`*^9}, {3.980504705863964*^9, 
  3.9805047115140743`*^9}, {3.9805047432113895`*^9, 
  3.9805047448272*^9}},ExpressionUUID->"fa4cd46c-587a-2e42-b16d-b2ca0f735ab8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "Here", " ", "we", " ", "perform", " ", "numerical", " ", "stability", " ",
       "analyses"}], ",", 
     RowBox[{"looking", " ", "for", " ", "a", " ", "value", " ", "of", " ", 
      FormBox[
       RowBox[{"x", "=", 
        RowBox[{"(", 
         RowBox[{"z", ",", 
          SubscriptBox["d", "0"], ",", "...", ",", 
          SubscriptBox["d", "N"]}]}]}],
       TraditionalForm]}]}], ")"}], " ", "where", " ", "directional", " ", 
   "selection", " ", "is", " ", "null", " ", "on", " ", "all", " ", 
   RowBox[{"traits", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "the", " ", "singular", " ", "value", " ", "under", " ", "unconditional", " ",
    "dispersal", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"when", " ", 
       SubscriptBox["d", "0"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["d", "1"], "=."}], ".."}], "=", 
       SubscriptBox["d", "N"]}]}], ")"}], ".", " ", "To"}], " ", "do", " ", 
   "so"}], ",", " ", 
  RowBox[{"we", " ", "use", " ", "the", " ", "Mathematica", " ", "function", " ", 
   RowBox[{"\"\<FindRoot\>\"", ".", " ", "This"}], " ", "corresponds", " ", 
   "to", " ", "the", " ", "procedure", " ", "described", " ", "in", " ", 
   "section", " ", "3.4", " ", "of", " ", "the", " ", "main", " ", "text", " ",
    "and", " ", "section", " ", "D", ".3", ".1", " ", "of", " ", "the", " ", 
   RowBox[{"Appendix", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "whether", " ", "the", " ", "singular", " ", "strategy", " ", "found", " ",
    "is", " ", "convergence", " ", "stable", " ", "by", " ", "computing", " ",
    "the", " ", "eigenvalues", " ", "if", " ", "the", " ", "Jacobian", " ", 
   "Matrix", " ", "at", " ", "the", " ", "singular", " ", "strategy", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "procedure", " ", "described", " ", "in", " ", "Appendix", " ", "D", 
      ".3", ".2"}], ")"}], ".", " ", "Finally"}]}], ",", " ", 
  RowBox[{
  "we", " ", "compute", " ", "the", " ", "eigenvalue", " ", "of", " ", "the", 
   " ", "Hessian", " ", "Matrix", " ", "to", " ", "determine", " ", "the", " ",
    "evolutionary", " ", "stability", " ", "of", " ", "the", " ", "singular", 
   " ", "equilibrium", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "procedure", " ", "described", " ", "in", " ", "Appendix", " ", "D", 
      ".3", ".3"}], ")"}], ".", " ", "We"}], " ", "write", " ", "the", " ", 
   "results", " ", "obtained", " ", "in", " ", 
   RowBox[{"a", " ", ".", "txt"}], " ", 
   RowBox[{"file", ".", "\[IndentingNewLine]", "You"}], " ", "will", " ", 
   "find", " ", "in", " ", "the", " ", "repository", " ", 
   RowBox[{"the", " ", ".", "txt"}], " ", "files", " ", "that", " ", "we", " ",
    "obtained", " ", "from", " ", "this", " ", "procedure"}], ",", " ", 
  RowBox[{
  "with", " ", "different", " ", "sets", " ", "of", " ", "parameter", " ", 
   "values", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"in", " ", "title"}], ")"}], "."}]}]}]], "Text",
 CellChangeTimes->{{3.9805042705898876`*^9, 3.9805042903561745`*^9}, {

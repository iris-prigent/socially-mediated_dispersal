Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "The", " ", "function", " ", "below", " ", "performs", " ", "numerical", 
      " ", "stability", " ", "analyses"}], ",", 
     RowBox[{"looking", " ", "for", " ", "a", " ", "value", " ", "of", " ", 
      FormBox[
       RowBox[{"x", "=", 
        RowBox[{"(", 
         RowBox[{"z", ",", 
          SubscriptBox["d", "0"], ",", "...", ",", 
          SubscriptBox["d", "N"]}]}]}],
       TraditionalForm]}]}], ")"}], " ", "where", " ", "directional", " ", 
   "selection", " ", "is", " ", "null", " ", "on", " ", "all", " ", 
   RowBox[{"traits", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "the", " ", "singular", " ", "value", " ", "under", " ", "unconditional", " ",
    "dispersal", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"when", " ", 
       SubscriptBox["d", "0"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["d", "1"], "=."}], ".."}], "=", 
       SubscriptBox["d", "N"]}]}], ")"}], ".", " ", "To"}], " ", "do", " ", 
   "so"}], ",", " ", 
  RowBox[{"we", " ", "use", " ", "the", " ", "Mathematica", " ", "function", " ", 
   RowBox[{"\"\<FindRoot\>\"", ".", " ", "This"}], " ", "corresponds", " ", 
   "to", " ", "the", " ", "procedure", " ", "described", " ", "in", " ", 
   "section", " ", "3.3", " ", "of", " ", "the", " ", "main", " ", "text", " ",
    "and", " ", "section", " ", "D", ".3", ".1", " ", "of", " ", "the", " ", 
   RowBox[{"Appendix", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "whether", " ", "the", " ", "singular", " ", "strategy", " ", "found", " ",
    "is", " ", "convergence", " ", "stable", " ", "by", " ", "computing", " ",
    "the", " ", "eigenvalues", " ", "if", " ", "the", " ", "Jacobian", " ", 
   "Matrix", " ", "at", " ", "the", " ", "singular", " ", "strategy", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "procedure", " ", "described", " ", "in", " ", "Appendix", " ", "D", 
      ".3", 
      RowBox[{".2", ".", " ", "The"}], " ", "function", " ", "returns", " ", 
      "the", " ", "singular", " ", "probability", " ", "of", " ", 
      "cooperation"}], ",", 
     RowBox[{
     "which", " ", "we", " ", "will", " ", "then", " ", "plot", " ", "using", 
      " ", "another", " ", 
      RowBox[{"function", ".", " ", "It"}], " ", "will", " ", "also", " ", 
      "print", " ", "\"\<convergence stable\>\"", " ", "if", " ", "the", " ", 
      "largest", "  ", "eigenvalues", " ", "of", " ", "Jacobian", " ", "is", " ", 
      RowBox[{"negative", ".", " ", "If"}], " ", "none", " ", "is", " ", 
      "stable", " ", 
      RowBox[{"(", 
       RowBox[{
       "as", " ", "this", " ", "is", " ", "the", " ", "case", " ", "here"}], 
       ")"}]}], ",", " ", 
     RowBox[{"it", " ", "will", " ", "print", " ", 
      RowBox[{"\"\<All singular strategies are convergence unstable\>\"", 
       "."}]}]}]}]}]}]], "Text",
 CellChangeTimes->{
  3.9889644505525723`*^9},ExpressionUUID->"35de1f6d-7b1e-e042-a779-\
853136dcf13c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", "**"}], "*", " ", "Define", " ", "the", " ", "important", " ",
     "functions"}], " ", "*******)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Pk0", "[", 
      RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
     RowBox[{
      SuperscriptBox["z", "k"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}], 
       RowBox[{"n", "-", "k"}]], 
      RowBox[{"Binomial", "[", 
       RowBox[{"n", ",", "k"}], "]"}]}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
    "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
     "cooperators", " ", "among", " ", "n", " ", "individuals", " ", "when", " ",
      "the", " ", "population", " ", "is", " ", "monomorphic", " ", "for", " ",
      "z"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fec", "[", 
      RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", 
          RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ", 
     "cooperating", " ", 
     RowBox[{"(", 
      RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 
     RowBox[{"(", 
      RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ", 
     "with", " ", "k", " ", "cooperators"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"1", "+", " ", 
       RowBox[{"\[Delta]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", " ", "/", "n"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", "Cc"}], " ", 
            ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"k", "/", "n"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], ")"}]}]}], ")"}]}]}], 
      ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "average", " ", "fecundity", " ", "in", " ", "a", " ", "patch", " ", 
     "with", " ", "k", " ", "cooperators"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"fecpatch", "[", "k", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
    "offspring", " ", "produced", " ", "that", " ", "will", " ", "remain", " ",
      "in", " ", "their", " ", "local", " ", "patch"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k2", "=", "0"}], "n"], 
      RowBox[{
       RowBox[{"d", "[", "k2", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "cd"}], ")"}], " ", 
       RowBox[{"fecpatch", "[", "k2", "]"}], 
       RowBox[{"Pk0", "[", 
        RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fecloc", "=", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", 
           RowBox[{"1", ",", 
            RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], ")"}],
         " ", 
        RowBox[{
         RowBox[{"fec", "[", 
          RowBox[{
           RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
          "]"}], "/", "n"}]}], "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", 
           RowBox[{"2", ",", 
            RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], ")"}],
         " ", 
        RowBox[{
         RowBox[{"fec", "[", 
          RowBox[{
           RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c2"}], 
          "]"}], "/", "n"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", 
           RowBox[{"3", ",", 
            RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], ")"}], 
        RowBox[{
         RowBox[{"fec", "[", 
          RowBox[{
           RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c3"}], 
          "]"}], "/", "n"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", 
           RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "3", "-", "c0"}], ")"}], 
           RowBox[{
            RowBox[{"fec", "[", 
             RowBox[{
              RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "0"}], 
             "]"}], "/", "n"}]}], "+", 
          RowBox[{"c0", " ", 
           RowBox[{
            RowBox[{"fec", "[", 
             RowBox[{
              RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "1"}], 
             "]"}], "/", "n"}]}]}], ")"}]}]}], " ", ")"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "number", " ", "of", " ", "offspring", " ", "coming", " ", "into", " ", 
     "an", " ", "arbirary", " ", "patch", " ", "when", " ", "the", " ", 
     "population", " ", "is", " ", "monomorphic", " ", "for", " ", "z"}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wdef", "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"c0", "=", "0"}], 
       RowBox[{"n", "-", "3"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"c3", "=", "0"}], "1"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"c2", "=", "0"}], "1"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"c1", "=", "0"}], "1"], 
         RowBox[{
          RowBox[{"fec", "[", 
           RowBox[{
            RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
           "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", "  ", 
              RowBox[{"1", "-", 
               RowBox[{"d", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
              ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"fecloc", "+", " ", 
               RowBox[{"fecdisp", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], " ", "+", 
            " ", 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"k0", "=", "0"}], "n"], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}], 
                  
                  RowBox[{"(", 
                   RowBox[{"1", "-", "cd"}], ")"}]}], " ", ")"}], "/", 
                RowBox[{"(", " ", 
                 RowBox[{
                  RowBox[{"fecphilo", "[", "k0", "]"}], "+", " ", 
                  RowBox[{"fecdisp", "[", 

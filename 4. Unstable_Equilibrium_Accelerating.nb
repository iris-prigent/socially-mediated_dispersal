Cell["2. Numerical analyses", "Section",
 CellChangeTimes->{{3.761458333892454*^9, 3.7614583437699337`*^9}, {
  3.9683081205610776`*^9, 3.9683081314968247`*^9}, {3.980504705863964*^9, 

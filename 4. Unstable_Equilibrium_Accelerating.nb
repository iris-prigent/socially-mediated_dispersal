                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], ")"}], 
              RowBox[{"Pk0", "[", 
               RowBox[{"k0", ",", 
                RowBox[{"d", "[", 
                 RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], 
           ")"}], 
          SuperscriptBox[
           RowBox[{"d", "[", 
            RowBox[{"1", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}], "c1"], 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Calczval", "[", 
    RowBox[{
    "\[Beta]val_", ",", "Ccval_", ",", "\[Delta]val_", ",", "nval_", ",", 
     "cdvect_", ",", "uval_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"values", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "nval"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "\[Beta]val"}], ",", 
        RowBox[{"Cc", "\[Rule]", " ", "Ccval"}], ",", 
        RowBox[{"\[Delta]", "->", "\[Delta]val"}], ",", 
        RowBox[{"u", "->", "uval"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"valuesNeutral", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "nval"}], ",", 
        RowBox[{"\[Delta]", "->", "0"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Functions", " ", "=", " ", 
      RowBox[{"{", " ", 
       RowBox[{"Bc", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"k", ",", 
          RowBox[{"n", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"k", "/", "n"}], ")"}], "u"], " ", "\[Beta]"}]}], 
         "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "[", "k0_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"fecdisp", "[", 

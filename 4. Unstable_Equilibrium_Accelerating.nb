Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "Here", " ", "we", " ", "perform", " ", "numerical", " ", "stability", " ",
       "analyses"}], ",", 
     RowBox[{"looking", " ", "for", " ", "a", " ", "value", " ", "of", " ", 
      FormBox[
       RowBox[{"x", "=", 
        RowBox[{"(", 
         RowBox[{"z", ",", 
          SubscriptBox["d", "0"], ",", "...", ",", 
          SubscriptBox["d", "N"]}]}]}],
       TraditionalForm]}]}], ")"}], " ", "where", " ", "directional", " ", 
   "selection", " ", "is", " ", "null", " ", "on", " ", "all", " ", 
   RowBox[{"traits", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "the", " ", "singular", " ", "value", " ", "under", " ", "unconditional", " ",
    "dispersal", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"when", " ", 
      SubscriptBox["d", "0"]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["d", "1"], "=."}], ".."}], "=", 
      SubscriptBox["d", "N"]}]}], ")"}], " ", "To", " ", "do", " ", "so"}], ",",
   " ", 
  RowBox[{"we", " ", "use", " ", "the", " ", "Mathematica", " ", "function", " ", 
   RowBox[{"\"\<FindRoot\>\"", ".", " ", "This"}], " ", "corresponds", " ", 
   "to", " ", "the", " ", "procedure", " ", "described", " ", "in", " ", 
   "section", " ", "3.3", " ", "of", " ", "the", " ", "main", " ", "text", " ",
    "and", " ", "section", " ", "D", ".3", ".1", " ", "of", " ", "the", " ", 
   RowBox[{"Appendix", ".", " ", "We"}], " ", "also", " ", "compute", " ", 
   "whether", " ", "the", " ", "singular", " ", "strategy", " ", "found", " ",
    "is", " ", "convergence", " ", "stable", " ", "by", " ", "computing", " ",
    "the", " ", "eigenvalues", " ", "if", " ", "the", " ", "Jacobian", " ", 
   "Matrix", " ", "at", " ", "the", " ", "singular", " ", "strategy", " ", 
   RowBox[{"(", 
    RowBox[{
    "procedure", " ", "described", " ", "in", " ", "Appendix", " ", "D", ".3", 
     RowBox[{".2", ".", " ", "We"}], " ", "write", " ", "the", " ", "results",
      " ", "obtained", " ", "in", " ", 
     RowBox[{"a", " ", ".", "txt"}], " ", 
     RowBox[{"file", "."}]}]}]}]}]], "Text",
 CellChangeTimes->{{3.9805042705898876`*^9, 3.9805042903561745`*^9}, {
   3.980504338492836*^9, 3.980504409075577*^9}, {3.9805044901538887`*^9, 

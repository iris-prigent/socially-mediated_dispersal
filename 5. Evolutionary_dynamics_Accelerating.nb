Cell[CellGroupData[{

Cell["2.1 Loss  cooperation", "Subsection",
 CellChangeTimes->{{3.9805064589788265`*^9, 3.9805064804744797`*^9}, {
  3.9805065529075756`*^9, 
  3.9805065578265095`*^9}},ExpressionUUID->"95367e58-e4f3-dd47-a558-\
13b2bdcfbff2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "We", " ", "follow", " ", "the", " ", "same", " ", "procedure", " ", "as", " ",
    "in", " ", "the", " ", "previous", " ", "section", " ", "but", " ", 
   "starting", " ", "from", " ", "z0"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FormBox[
        RowBox[{"0.9", ",", "0.7", ",", "0.55", ",", "0.4", ",", 
         SuperscriptBox["d", "*"]}],
        TraditionalForm], ",", "1"}], "}"}], ".", " ", "It"}], " ", "stops", " ",
     "the", " ", "iteration", " ", "once", " ", "the", " ", "population", " ",
     "expresses", "  ", "z"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"1", " ", ".", " ", "This"}], " ", "corresponds", " ", "to", " ", 
    "the", " ", "procedure", " ", "described", " ", "in", " ", "Appendix", " ",
     "D", 
    RowBox[{".1", "."}]}]}]}]], "Text",
 CellChangeTimes->{{3.9805066006303024`*^9, 
  3.98050665963929*^9}},ExpressionUUID->"6b8ebe2c-a064-2e47-be78-\
9f6391b505b1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0", " ", "=", "  ", 
   RowBox[{"{", 
    RowBox[{
    "0.9", ",", "0.7", ",", "0.55", ",", "0.4", ",", "d0baseline", ",", 
     "1."}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", " ", "=", 
   RowBox[{"0.1", " ", 
    RowBox[{"IdentityMatrix", "[", 
     RowBox[{"ntest", "+", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res", " ", "=", " ", 
   RowBox[{"NestWhileList", "[", 
    RowBox[{"\[CapitalDelta]z", ",", "z0", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"EuclideanDistance", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ">", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "&"}], ",", "2", ",", "5000"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"res", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"ntest", "+", "1"}]}], "]"}], "]"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Map", "[", 
       RowBox[{

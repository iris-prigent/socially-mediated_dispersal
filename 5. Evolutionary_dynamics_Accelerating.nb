Cell[BoxData[
 RowBox[{
  RowBox[{
  "This", " ", "numerical", " ", "analyses", " ", "iterates", " ", "a", " ", 
   "perturbation", " ", "in", " ", "the", " ", "direction", " ", "of", " ", 
   "the", " ", "selection", " ", "gradient", " ", "vector", " ", "on", " ", 
   "the", " ", "population", " ", 
   RowBox[{"traits", "'"}], " ", 
   RowBox[{"values", ".", " ", "We"}], " ", "start", " ", "from", " ", "a", " ",
    "population", " ", "of", "  ", "defectors", " ", "expressing", " ", 
   "initial", " ", "phenotypic", " ", "value", " ", "z0"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FormBox[
        SuperscriptBox["d", "*"],
        TraditionalForm], ",", " ", "0.4", ",", "0.6", ",", "0.7", ",", "0.9",
        ",", "0"}], "}"}], ".", " ", "It"}], " ", "stops", " ", "the", " ", 
    "iteration", " ", "once", " ", "the", " ", "population", " ", "expresses",
     "  ", "z"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"1", " ", ".", " ", "This"}], " ", "corresponds", " ", "to", " ", 
    "the", " ", "procedure", " ", "described", " ", "in", " ", "Appendix", " ",
     "D", 
    RowBox[{".1", "."}]}]}]}]], "Text",
 CellChangeTimes->{{3.9805064860250263`*^9, 
  3.980506511836815*^9}},ExpressionUUID->"69b73062-43e9-7547-bf7f-\
8bac0a4d7e4d"],


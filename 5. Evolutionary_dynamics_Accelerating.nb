              RowBox[{"k", "/", "n"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], ")"}]}]}], ")"}]}]}],
        ")"}]}], ";", "\[IndentingNewLine]", 

       SuperscriptBox["z", "k"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        RowBox[{"n", "-", "k"}]], 
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", "k"}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 

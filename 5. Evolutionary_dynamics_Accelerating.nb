Cell[BoxData[
 RowBox[{"NumericAnalysesLoss", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Print", "[", "cdi", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"values", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "4"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "4"}], ",", 
        RowBox[{"Cc", "\[Rule]", " ", "0.3"}], ",", 
        RowBox[{"\[Delta]", "\[Rule]", "1."}], ",", 
        RowBox[{"u", "\[Rule]", "2."}], ",", 
        RowBox[{"cd", "\[Rule]", " ", "cdi"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ntest", " ", "=", " ", 
      RowBox[{"n", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cdtest", " ", "=", " ", 
      RowBox[{"cd", "  ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"utest", " ", "=", " ", 
      RowBox[{"u", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"valuesNeutral", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "ntest"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "0"}], ",", 
        RowBox[{"Cc", "\[Rule]", " ", "0"}], ",", 
        RowBox[{"cd", "\[Rule]", "cdtest"}], ",", 
        RowBox[{"u", "\[Rule]", " ", "utest"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d0baseline", "=", 
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "cd", " ", "n"}], "+", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["cd", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}], 
            ")"}]}]}], ")"}]}], "/.", "values"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Pk0", "[", 
       RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 

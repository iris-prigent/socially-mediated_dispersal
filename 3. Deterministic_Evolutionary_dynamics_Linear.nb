Cell["3.1 Fixation of cooperation from rarity", "Subsection",
 CellChangeTimes->{{3.9805036509882584`*^9, 
  3.9805036720447464`*^9}},ExpressionUUID->"b54b1b83-62ed-d54b-bb99-\
a7f3920c9c0b"],

Cell[TextData[{
 "We repeat the process described above for 100 different initial dispersal \
values, with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "0"], TraditionalForm]],ExpressionUUID->
  "f84299c5-9797-6640-af64-9874540366ff"],
 "=",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "*"], TraditionalForm]],ExpressionUUID->
  "56077544-c011-bd4a-8eb6-1837bd480455"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "1"], TraditionalForm]],ExpressionUUID->
  "2a436297-8921-8947-9741-6cb1514aee35"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 

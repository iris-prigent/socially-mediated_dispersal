   3.9805036048132973`*^9}},ExpressionUUID->"d2b575bf-27ef-4555-9ff2-\
0464045ea41b"],

Cell[BoxData[
 RowBox[{"NumericAnalysesInvade", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Print", "[", "cdi", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"values", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "4"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "1"}], ",", 
        RowBox[{"Cc", "\[Rule]", " ", "0.3"}], ",", 
        RowBox[{"\[Delta]", "\[Rule]", "1."}], ",", 
        RowBox[{"u", "\[Rule]", "1."}], ",", 
        RowBox[{"cd", "\[Rule]", " ", "cdi"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ntest", " ", "=", " ", 
      RowBox[{"n", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cdtest", " ", "=", " ", 
      RowBox[{"cd", "  ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"utest", " ", "=", " ", 
      RowBox[{"u", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"valuesNeutral", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "ntest"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "0"}], ",", 
        RowBox[{"Cc", "\[Rule]", " ", "0"}], ",", 
        RowBox[{"cd", "\[Rule]", "cdtest"}], ",", 
        RowBox[{"u", "\[Rule]", " ", "utest"}]}], "}"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "[", "k_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"fecdisp", "[", 
         RowBox[{"d", "[", 
          RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"fecpatch", "[", "k", "]"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", 
          RowBox[{"fecdisp", "[", 
           RowBox[{"d", "[", 
            RowBox[{"n", "+", "1"}], "]"}], "]"}]}], " ", ")"}]}], "/.", 
       RowBox[{"\[Delta]", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d0baseline", "=", 
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "cd", " ", "n"}], "+", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["cd", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}], 
            ")"}]}]}], ")"}]}], "/.", "values"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"solR2", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"R2", " ", "\[Equal]", " ", 
              RowBox[{
               UnderoverscriptBox["\[Sum]", 
                RowBox[{"c0", "=", "0"}], "n"], 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"m", "[", "c0", "]"}]}], ")"}], "2"], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "n"}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], "/", "n"}], ")"}], 
                   "R2"}]}], ")"}], 
                RowBox[{"Pk0", "[", 
                 RowBox[{"c0", ",", 
                  RowBox[{"d", "[", 
                   RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], "/.",
              "valuesNeutral"}], "/.", "Functions"}], "//.", 
           "valuesNeutral"}], ")"}], ",", "R2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Pk0", "[", 
       RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
      RowBox[{
       SuperscriptBox["z", "k"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        RowBox[{"n", "-", "k"}]], 
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", "k"}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
       "cooperators", " ", "among", " ", "n", " ", "individuals", " ", "when",
        " ", "the", " ", "population", " ", "is", " ", "monomorphic", " ", 
       "for", " ", "z"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fec", "[", 
       RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Delta]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", 
           RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " ", ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ",
        "cooperating", " ", 
       RowBox[{"(", 
        RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 
       RowBox[{"(", 
        RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ",
        "with", " ", "k", " ", "cooperators"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
      RowBox[{"(", 
       RowBox[{"1", "+", " ", 
        RowBox[{"\[Delta]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", " ", "/", "n"}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", "Cc"}], " ", 
             ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"k", "/", "n"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], ")"}]}]}], ")"}]}]}],
        ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "average", " ", "fecundity", " ", "in", " ", "a", " ", "patch", " ", 
       "with", " ", "k", " ", "cooperators"}], "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
      RowBox[{
       RowBox[{"fecpatch", "[", "k", "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "offspring", " ", "produced", " ", "that", " ", "will", " ", "remain", " ",
        "in", " ", "their", " ", "local", " ", "patch"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k2", "=", "0"}], "n"], 
       RowBox[{
        RowBox[{"d", "[", "k2", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "cd"}], ")"}], " ", 
        RowBox[{"fecpatch", "[", "k2", "]"}], 
        RowBox[{"Pk0", "[", 
         RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"c0", "=", "0"}], 
           RowBox[{"n", "-", "3"}]], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"c3", "=", "0"}], "1"], 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"c2", "=", "0"}], "1"], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"c1", "=", "0"}], "1"], 
             RowBox[{
              RowBox[{"fec", "[", 
               RowBox[{
                RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
               "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", "  ", 
                  RowBox[{"1", "-", 
                   RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c1"}], "]"}], "/", "n"}]}], "+", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"2", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c2"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"3", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c3"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 

Cell[CellGroupData[{

Cell["\<\
2. Tracking the evolutionary dynamics through time (Figure 3c)\
\>", "Section",
 CellChangeTimes->{{3.980502597312374*^9, 3.980502625620413*^9}, 
   3.980503205219919*^9},ExpressionUUID->"a7e74349-017b-1040-aa63-\
4f9b871b76b4"],

Cell[TextData[{
 "This numerical analyses iterates a perturbation in the direction of the \
selection gradient vector on the population traits' values. We start from a \
population of  defectors expressing initial phenotypic value z0={",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ae7b987-e5c6-904b-9e5c-755ed9d1eb37"],
 ", 0.4, 0.6, 0.7, 0.9, 0}. It stops the iteration once the population \
expresses z = 0 or z = 1 (here z=1). This corresponds to the procedure \
described in Appendix D.1."
}], "Text",
 CellChangeTimes->{{3.9805030235317783`*^9, 3.9805031961496773`*^9}, {
  3.9805034574048023`*^9, 
  3.980503458772787*^9}},ExpressionUUID->"73058392-6164-3b4e-88b4-\
73d070c4f870"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", "\[Rule]", "4"}], ",", 
     RowBox[{"\[Beta]", "\[Rule]", "1"}], ",", 
     RowBox[{"Cc", "\[Rule]", " ", "0.3"}], ",", 
     RowBox[{"\[Delta]", "\[Rule]", "1"}], ",", 
     RowBox[{"u", "\[Rule]", "1"}], ",", 
     RowBox[{"cd", "\[Rule]", " ", "0.5"}]}], "}"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ntest", " ", "=", " ", 
   RowBox[{"n", " ", "/.", " ", "values"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cdtest", " ", "=", " ", 
   RowBox[{"cd", "  ", "/.", " ", "values"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"utest", " ", "=", " ", 
   RowBox[{"u", " ", "/.", " ", "values"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valuesNeutral", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", "\[Rule]", "ntest"}], ",", 
     RowBox[{"\[Beta]", "\[Rule]", "0"}], ",", 
     RowBox[{"Cc", "\[Rule]", " ", "0"}], ",", 
     RowBox[{"cd", "\[Rule]", "cdtest"}], ",", 
     RowBox[{"u", "\[Rule]", " ", "utest"}]}], "}"}]}], " ", ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"fecdisp", "[", 
      RowBox[{"d", "[", 
       RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"fecpatch", "[", "k", "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", 
       RowBox[{"fecdisp", "[", 
        RowBox[{"d", "[", 
         RowBox[{"n", "+", "1"}], "]"}], "]"}]}], " ", ")"}]}], "/.", 
    RowBox[{"\[Delta]", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d0baseline", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "cd", " ", "n"}], "+", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["cd", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}], ")"}]}]}], 
       ")"}]}], "/.", "Functions"}], "//.", "values"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solR2", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"R2", " ", "\[Equal]", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"c0", "=", "0"}], "n"], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"m", "[", "c0", "]"}]}], ")"}], "2"], 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "n"], "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"n", "-", "1"}], "n"], "R2"}]}], ")"}], 
             RowBox[{"Pk0", "[", 
              RowBox[{"c0", ",", 
               RowBox[{"d", "[", 
                RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], "/.",
           "valuesNeutral"}], "/.", "Functions"}], "//.", "valuesNeutral"}], 
       ")"}], ",", "R2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Pk0", "[", 
     RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox["z", "k"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], 
      RowBox[{"n", "-", "k"}]], 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", "k"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
    "cooperators", " ", "among", " ", "n", " ", "individuals", " ", "when", " ",
     "the", " ", "population", " ", "is", " ", "monomorphic", " ", "for", " ",
     "z"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fec", "[", 
    RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"\[Delta]", " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"Bc", "[", "k", "]"}], "n"], "-", 
        RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ", 
    "cooperating", " ", 
    RowBox[{"(", 
     RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 
    RowBox[{"(", 
     RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ", 
    "with", " ", "k", " ", "cooperators"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{"1", "+", " ", 
      RowBox[{"\[Delta]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", " ", "/", "n"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"Bc", "[", "k", "]"}], "n"], "-", "Cc"}], " ", ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"k", "/", "n"}]}], ")"}], 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"Bc", "[", "k", "]"}], "n"], ")"}]}]}], ")"}]}]}], 
     ")"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "average", " ", "fecundity", " ", "in", " ", "a", " ", "patch", " ", 
    "with", " ", "k", " ", "cooperators"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"fecpatch", "[", "k", "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "offspring", " ", "produced", " ", "that", " ", "will", " ", "remain", " ",
     "in", " ", "their", " ", "local", " ", "patch"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k2", "=", "0"}], "n"], 
     RowBox[{
      RowBox[{"d", "[", "k2", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "cd"}], ")"}], " ", 
      RowBox[{"fecpatch", "[", "k2", "]"}], 
      RowBox[{"Pk0", "[", 
       RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "number", " ", "of", " ", "offspring", " ", "coming", " ", "into", " ", 
    "an", " ", "arbirary", " ", "patch", " ", "when", " ", "the", " ", 
    "population", " ", "is", " ", "monomorphic", " ", "for", " ", "z"}], " ", 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"c0", "=", "0"}], 
        RowBox[{"n", "-", "3"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"c3", "=", "0"}], "1"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"c2", "=", "0"}], "1"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"c1", "=", "0"}], "1"], 
          RowBox[{
           RowBox[{"fec", "[", 
            RowBox[{
             RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}], 
            "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", "  ", 
               RowBox[{"1", "-", 
                RowBox[{"d", "[", 
                 RowBox[{"1", ",", 
                  RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}]}], 
               ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                   RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c1"}], "]"}], "/", "n"}]}], "+", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"2", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                   RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c2"}], "]"}], "/", "n"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"3", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], 
                   RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c3"}], "]"}], "/", "n"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], 
                    ")"}], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 

Cell[CellGroupData[{

Cell["3.1 Loss of cooperation from abundance", "Subsection",
 CellChangeTimes->{{3.9805036509882584`*^9, 
  3.980503689035568*^9}},ExpressionUUID->"1315fc1a-6592-6a4c-bc09-\
91ce34f78d9b"],

Cell[TextData[{
 "We repeat the process but starting from a population of full cooperators. \
In that case, the initial phenotype express in the population is  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z0", "=", 
    RowBox[{"{", 
     SubscriptBox["d", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f89e25d-aec5-7a4b-95ba-9399e441e541"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "1"], TraditionalForm]],ExpressionUUID->
  "b84c13b3-16d9-044f-b29d-a81ac87584a0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "2"], TraditionalForm]],ExpressionUUID->
  "b0e7e89d-f8b1-7a40-a005-4806b456f868"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "3"], TraditionalForm]],ExpressionUUID->
  "e5d817f6-bc9b-284b-a677-cd73afb84262"],
 ",",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d641c69b-b7b3-ae41-8a0e-94cda3dcaf69"],
 ", 1} with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "3"], TraditionalForm]],ExpressionUUID->
  "eb104bb4-6122-2840-8f20-6492e8e0277b"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
     "taking", " ", "value", " ", "between", " ", "0", " ", "and", " ", "1"}],
      ",", " ", 
     RowBox[{"and", " ", 
      SubscriptBox["d", "0"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c00d6ef8-1d51-fa4a-ad88-df3d98957883"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["d", 
     RowBox[{"1", " "}]]}], TraditionalForm]],ExpressionUUID->
  "da89d89f-d9ca-cc4e-962a-c77ab17b61ba"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "2"], TraditionalForm]],ExpressionUUID->
  "a3622ee9-08b9-1a4c-b30d-94f59b26fac7"],
 " chosen at random. We keep track of the proportion of initial conditions \
that lead to z=0. As this procedure takes some computational time, we write \
the output in a .txt file that may then be imported."
}], "Text",
 CellChangeTimes->{{3.9653796388564687`*^9, 3.965379826578865*^9}, {
   3.980502745777399*^9, 3.9805029768595123`*^9}, 3.980503020585594*^9, {
   3.980503314507904*^9, 3.9805034366967754`*^9}, {3.980503486439577*^9, 
   3.9805035177897396`*^9}, {3.98050356057572*^9, 3.9805036048132973`*^9}, {
   3.9805039199051285`*^9, 3.9805039545885124`*^9}, {3.9805039849136887`*^9, 
   3.980504084276785*^9}},ExpressionUUID->"0136a408-b5d2-c34a-9f3d-\
01f975df73d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NumericAnalysesLoss", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", "cdi", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"values", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "\[Rule]", "4"}], ",", 
         RowBox[{"\[Beta]", "\[Rule]", "1"}], ",", 
         RowBox[{"Cc", "\[Rule]", " ", "0.3"}], ",", 
         RowBox[{"\[Delta]", "\[Rule]", "1."}], ",", 
         RowBox[{"u", "\[Rule]", "1."}], ",", 
         RowBox[{"cd", "\[Rule]", " ", "cdi"}]}], "}"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Beta]val", "=", 
       RowBox[{"\[Beta]", "/.", "values"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Ccval", "=", 
       RowBox[{"Cc", "/.", "values"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ntest", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cdtest", " ", "=", " ", 
       RowBox[{"cd", "  ", "/.", " ", "values"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"utest", " ", "=", " ", 
       RowBox[{"u", " ", "/.", " ", "values"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"valuesNeutral", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "\[Rule]", "ntest"}], ",", 
         RowBox[{"\[Beta]", "\[Rule]", "0"}], ",", 
         RowBox[{"Cc", "\[Rule]", " ", "0"}], ",", 
         RowBox[{"cd", "\[Rule]", "cdtest"}], ",", 
         RowBox[{"u", "\[Rule]", " ", "utest"}]}], "}"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m", "[", "k_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"fecdisp", "[", 
          RowBox[{"d", "[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"fecpatch", "[", "k", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"d", "[", "k", "]"}]}], ")"}]}], "+", 
           RowBox[{"fecdisp", "[", 
            RowBox[{"d", "[", 
             RowBox[{"n", "+", "1"}], "]"}], "]"}]}], " ", ")"}]}], "/.", 
        RowBox[{"\[Delta]", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d0baseline", "=", 
       RowBox[{
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "cd", " ", "n"}], "+", 
           RowBox[{"\[Sqrt]", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"4", " ", 
               SuperscriptBox["cd", "2"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}], 
             ")"}]}]}], ")"}]}], "/.", "values"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solR2", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"R2", " ", "\[Equal]", " ", 
               RowBox[{
                UnderoverscriptBox["\[Sum]", 
                 RowBox[{"c0", "=", "0"}], "n"], 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    RowBox[{"m", "[", "c0", "]"}]}], ")"}], "2"], 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "n"}], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], "/", "n"}], ")"}], 
                    "R2"}]}], ")"}], 
                 RowBox[{"Pk0", "[", 
                  RowBox[{"c0", ",", 
                   RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], "/.",
               "valuesNeutral"}], "/.", "Functions"}], "//.", 
            "valuesNeutral"}], ")"}], ",", "R2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Pk0", "[", 
        RowBox[{"k_", ",", "z_", ",", "n_"}], "]"}], ":=", 
       RowBox[{
        SuperscriptBox["z", "k"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}], 
         RowBox[{"n", "-", "k"}]], 
        RowBox[{"Binomial", "[", 
         RowBox[{"n", ",", "k"}], "]"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Probability", " ", "that", " ", "there", " ", "is", " ", "k", " ", 
        "cooperators", " ", "among", " ", "n", " ", "individuals", " ", 
        "when", " ", "the", " ", "population", " ", "is", " ", "monomorphic", 
        " ", "for", " ", "z"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fec", "[", 
        RowBox[{"k_", ",", "j_"}], "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Delta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", 
            RowBox[{"Cc", " ", "j"}]}], ")"}]}]}], ")"}]}], " ", ";", 
      RowBox[{"(*", " ", 
       RowBox[{
       "fecundity", " ", "of", " ", "an", " ", "individual", " ", "either", " ",
         "cooperating", " ", 
        RowBox[{"(", 
         RowBox[{"j", "=", "1"}], ")"}], " ", "or", " ", "defecting", " ", 
        RowBox[{"(", 
         RowBox[{"j", "=", "0"}], ")"}], " ", "in", " ", "a", " ", "group", " ",
         "with", " ", "k", " ", "cooperators"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecpatch", "[", "k_", "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{"\[Delta]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "/", "n"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], "-", "Cc"}], " ", 
              ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"k", "/", "n"}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Bc", "[", "k", "]"}], "/", "n"}], ")"}]}]}], 
           ")"}]}]}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "average", " ", "fecundity", " ", "in", " ", "a", " ", "patch", " ", 
        "with", " ", "k", " ", "cooperators"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecphilo", "[", "k_", "]"}], ":=", 
       RowBox[{
        RowBox[{"fecpatch", "[", "k", "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"d", "[", "k", "]"}]}], ")"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
       "offspring", " ", "produced", " ", "that", " ", "will", " ", "remain", 
        " ", "in", " ", "their", " ", "local", " ", "patch"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fecdisp", "[", "z_", "]"}], ":=", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k2", "=", "0"}], "n"], 
        RowBox[{
         RowBox[{"d", "[", "k2", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "cd"}], ")"}], " ", 
         RowBox[{"fecpatch", "[", "k2", "]"}], 
         RowBox[{"Pk0", "[", 
          RowBox[{"k2", ",", "z", ",", "n"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"c0", "=", "0"}], 
            RowBox[{"n", "-", "3"}]], 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"c3", "=", "0"}], "1"], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"c2", "=", "0"}], "1"], 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"c1", "=", "0"}], "1"], 
              RowBox[{
               RowBox[{"fec", "[", 
                RowBox[{
                 RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", "c1"}],
                 "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", "  ", 
                   RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c1"}], "]"}], "/", "n"}]}], "+", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"2", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c2"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"3", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], 
                    "]"}]}], ")"}], 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "c3"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"d", "[", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", "3", "-", "c0"}], ")"}], 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "0"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{"c0", " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "1"}], "]"}], "/", "n"}]}]}], ")"}]}]}], " ", ")"}], "+", 
                    " ", 
                    RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], " ", "+",
                  " ", 
                 RowBox[{
                  UnderoverscriptBox["\[Sum]", 
                   RowBox[{"k0", "=", "0"}], "n"], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}], 
                    
                    RowBox[{"(", 
                    RowBox[{"1", "-", "cd"}], ")"}]}], " ", ")"}], "/", 
                    RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{"fecphilo", "[", "k0", "]"}], "+", " ", 
                    RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 

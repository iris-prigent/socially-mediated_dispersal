                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "0"}], "]"}], "/", "n"}]}], "+", 
                    RowBox[{"c0", " ", 
                    RowBox[{
                    RowBox[{"fec", "[", 
                    RowBox[{
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}], ",", 
                    "1"}], "]"}], "/", "n"}]}]}], ")"}]}]}], " ", ")"}], "+", 
                   " ", 
                   RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], " ", "+",
                 " ", 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"k0", "=", "0"}], "n"], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"c1", "+", "c2", "+", "c3", "+", "c0"}]}], "]"}], 
                    
                    RowBox[{"(", 
                    RowBox[{"1", "-", "cd"}], ")"}]}], " ", ")"}], "/", 
                    RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{"fecphilo", "[", "k0", "]"}], "+", " ", 
                    RowBox[{"fecdisp", "[", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}]}], ")"}], 
                  RowBox[{"Pk0", "[", 
                   RowBox[{"k0", ",", 
                    RowBox[{"d", "[", 
                    RowBox[{"n", "+", "1"}], "]"}], ",", "n"}], "]"}]}]}]}], 
               ")"}], 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c1"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"1", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c1"}]], " ", 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c2"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"2", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c2"}]], 
              SuperscriptBox[
               RowBox[{"d", "[", 
                RowBox[{"3", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "c3"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"3", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}]}], ")"}], 
               RowBox[{"1", "-", "c3"}]], " ", 
              RowBox[{"Pk0", "[", 
               RowBox[{"c0", ",", 
                RowBox[{"d", "[", 
                 RowBox[{"n", "+", "1"}], "]"}], ",", 
                RowBox[{"n", "-", "3"}]}], "]"}]}]}]}]}]}], "/.", "values"}], 
        "/.", "Functions"}], "//.", "values"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"monopop", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"i", ",", "k"}], "]"}], "\[Rule]", " ", 
           RowBox[{"d", "[", "k", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"ntest", "+", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"S", "=", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"w", ",", " ", 
              RowBox[{"d", "[", 
               RowBox[{"1", ",", "k"}], "]"}]}], "]"}], "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "R2", " ", 
             RowBox[{"D", "[", 
              RowBox[{"w", ",", " ", 
               RowBox[{"d", "[", 
                RowBox[{"2", ",", "k"}], "]"}]}], "]"}]}]}], "/.", " ", 
           "solR2"}], " ", "/.", " ", "monopop"}], " ", "/.", "values"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"ntest", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", "**"}], "*", " ", "Creating", " ", "the", " ", "results",
        " ", 
       RowBox[{"file", " ", "**"}]}], "*****)"}], "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"\"\<NumericAnalysesInvade_b_\>\"", "<>", 
        RowBox[{"TextString", "[", "\[Beta]val", "]"}], "<>", "\"\<_C_\>\"", "<>", 
        RowBox[{"TextString", "[", "Ccval", "]"}], "<>", "\"\<_n_\>\"", "<>", 
        
        RowBox[{"TextString", "[", "ntest", "]"}], "<>", "\"\<.txt\>\""}], "/.",
        "values"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FileExistsQ", "[", "f", "]"}]}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "If", " ", "it", " ", "does", " ", "not", " ", "exist", " ", "yet"}],
          ",", " ", 
         RowBox[{"create", " ", "it"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"CreateFile", "[", "f", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Close", "[", "f", "]"}], " ", "//", "Quiet"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stream", "=", 
         RowBox[{"OpenAppend", "[", "f", "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Close", "[", "f", "]"}], " ", "//", "Quiet"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"res", "=", "\[IndentingNewLine]", 
         RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"z0Random", "=", 
             RowBox[{"Append", "[", " ", 
              RowBox[{
               RowBox[{"Table", "[", " ", 
                RowBox[{
                 RowBox[{"RandomReal", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    SuperscriptBox["10", 
                    RowBox[{"-", "5"}]], ",", 
                    RowBox[{"1", "-", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "5"}]]}]}], "}"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", 
                   RowBox[{"ntest", "+", "1"}]}], "}"}]}], "]"}], " ", ",", 
               "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"z0", "=", " ", "z0Random"}], ";", "\[IndentingNewLine]", 
            
            RowBox[{
             RowBox[{"z0", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "=", " ", "d0baseline"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"z0", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "=", "d1"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"G", " ", "=", 
             RowBox[{"0.1", " ", 
              RowBox[{"IdentityMatrix", "[", 
               RowBox[{"ntest", "+", "2"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[CapitalDelta]z", "[", "u_", "]"}], ":=", 
             RowBox[{"Clip", "[", " ", 
              RowBox[{
               RowBox[{"u", "+", 
                RowBox[{"G", ".", 
                 RowBox[{"(", 
                  RowBox[{"S", "/.", " ", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"d", "[", "k", "]"}], "\[Rule]", " ", 
                    RowBox[{"u", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", "+", "k"}], "]"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "0", ",", 
                    RowBox[{"ntest", "+", "1"}]}], "}"}]}], "]"}]}], " ", 
                  ")"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"0.", ",", "1."}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ngenmax", "=", "5000"}], ";", "\[IndentingNewLine]", 
            RowBox[{"res0", "=", 
             RowBox[{"NestWhile", "[", 
              RowBox[{"\[CapitalDelta]z", ",", "z0", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", 
                    RowBox[{"ntest", "+", "2"}], "]"}], "]"}], "-", 
                   RowBox[{"#2", "[", 
                    RowBox[{"[", 
                    RowBox[{"ntest", "+", "2"}], "]"}], "]"}]}], "]"}], ">", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "8"}]]}], "&"}], ",", "2", ",", "ngenmax"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"fix0", "=", 
             RowBox[{"Last", "[", "res0", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Round", "[", 
             RowBox[{"fix0", ",", "0.1"}], "]"}]}], "\[IndentingNewLine]", ",",
            "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "100"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stream", "=", 
         RowBox[{"OpenAppend", "[", "f", "]"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"Output", " ", "stream"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"WriteLine", "[", 
         RowBox[{"stream", ",", 
          RowBox[{"StringRiffle", "[", 
           RowBox[{"{", 
            RowBox[{"cdi", ",", "d1", ",", 
             RowBox[{"Mean", "[", "res", "]"}]}], "}"}], " ", "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Close", "[", "f", "]"}], " ", "//", "Quiet"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"cdi", ",", "d1", ",", 
          RowBox[{"Mean", "[", "res", "]"}]}], "}"}]}], " ", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"d1", "\[Equal]", " ", 
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "cd", " ", "n"}], "+", 
           RowBox[{"\[Sqrt]", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"4", " ", 
               SuperscriptBox["cd", "2"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}]}], 
             ")"}]}]}], ")"}]}]}], "/.", 
       RowBox[{"n", "->", "4"}]}], "]"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"cd", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d1", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Lighter", "[", 
             RowBox[{"blue", ",", "#"}], "]"}], "&"}], ",", 
           RowBox[{"Reverse", "[", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "0.8", ",", 
              RowBox[{"N", "[", 
               RowBox[{"0.8", "/", 
                RowBox[{"(", "ntest", ")"}]}], "]"}]}], "]"}], "]"}]}], "]"}],
          "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"Plotfix", ",", "p2"}], "]"}]}], "Input",

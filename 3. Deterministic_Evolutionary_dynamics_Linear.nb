Cell[CellGroupData[{

Cell["3. Basin of attraction for full and loss of cooperation", "Section",
 CellChangeTimes->{{3.980502597312374*^9, 3.980502625620413*^9}, 
   3.980503205219919*^9, {3.980503249307379*^9, 3.9805033010449104`*^9}, {

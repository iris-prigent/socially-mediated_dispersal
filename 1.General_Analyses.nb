Cell[CellGroupData[{

Cell["2. Selection on defection", "Section",
 CellChangeTimes->{{3.9418966341177297`*^9, 3.9418966690383396`*^9}, {
  3.944582890397169*^9, 3.944582891522981*^9}, {3.965293421967767*^9, 
  3.9652934413706975`*^9}},ExpressionUUID->"8116396f-291a-4c74-b4b4-\
4b1080088b53"],

Cell["\<\
Here we derive the conditions for  cooperation to be maintained, or \
equivalently, the conditions under which defection cannot invade a population \
of full cooperators.  These results are presented in Appendix C.2.\
\>", "Text",
 CellChangeTimes->{{3.941896750468131*^9, 3.9418968038515673`*^9}, {
  3.9596866791613913`*^9, 3.959686696252305*^9}, {3.965293196432141*^9, 
  3.9652932926477776`*^9}},ExpressionUUID->"f74ab88c-3c2c-4653-a108-\
6c510c3101a7"],

